<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FishBalanceWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FishBalanceWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Fish Balance Manager">

    <!-- Step 2e: laid out element-by-element against the WinUI 3 concept mock-up.
         Only the Data Entry tab is real; the other tabs, the menus and Finalize Day are placeholders. -->
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <x:Double x:Key="MenuBarHeight">30</x:Double>
                <!-- Compact rows for the drill-down dialog list (built in code) -->
                <Style x:Key="TightListItemStyle" TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="24" />
                </Style>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="AppBgBrush" Color="#EEF3F8" />
                        <SolidColorBrush x:Key="MenuBgBrush" Color="#F8FAFD" />
                        <SolidColorBrush x:Key="PanelBrush" Color="#F6F8FB" />
                        <SolidColorBrush x:Key="TabSelBrush" Color="#F9FAFC" />
                        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="HeaderBrush" Color="#EFF4F9" />
                        <SolidColorBrush x:Key="LineBrush" Color="#E3E8EF" />
                        <SolidColorBrush x:Key="IconBlueBrush" Color="#0A67D8" />
                        <SolidColorBrush x:Key="TabAccentBrush" Color="#0965DF" />
                        <SolidColorBrush x:Key="GoodBrush" Color="#1F7F3C" />
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="#0A6AE0" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#0A5CC4" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#094FA8" />
                        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#0A6AE0" />
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#0A5CC4" />
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#094FA8" />
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="AppBgBrush" Color="#1B2330" />
                        <SolidColorBrush x:Key="MenuBgBrush" Color="#202A38" />
                        <SolidColorBrush x:Key="PanelBrush" Color="#232D3C" />
                        <SolidColorBrush x:Key="TabSelBrush" Color="#2A3547" />
                        <SolidColorBrush x:Key="CardBrush" Color="#2B3647" />
                        <SolidColorBrush x:Key="HeaderBrush" Color="#323E50" />
                        <SolidColorBrush x:Key="LineBrush" Color="#3A4659" />
                        <SolidColorBrush x:Key="IconBlueBrush" Color="#60CDFF" />
                        <SolidColorBrush x:Key="TabAccentBrush" Color="#60CDFF" />
                        <SolidColorBrush x:Key="GoodBrush" Color="#6CCB5F" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

    <Grid x:Name="RootGrid" Loaded="Root_Loaded" Background="{ThemeResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0" Background="{ThemeResource MenuBgBrush}">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="New" Click="New_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Open..." Click="Open_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="O" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Save" Click="Save_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Save As..." Click="SaveAs_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Print Preview..." Click="PrintPreview_Click" />
                <MenuFlyoutItem Text="Print Breakdown..." Click="Print_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="P" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="Exit_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Edit">
                <MenuFlyoutItem Text="Not in the WinUI edition yet" IsEnabled="False" />
            </MenuBarItem>
            <MenuBarItem x:Name="ToolsMenu" Title="Tools">
                <MenuFlyoutItem Text="Manage Supplier / Species Names..." Click="ManageNames_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="Not in the WinUI edition yet" IsEnabled="False" />
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="1" Margin="8,2,8,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Tab strip: raised selected tab with an accent underline, like the mock-up -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="0" Margin="2,0,0,0">
                <Grid x:Name="TabHead0" Tag="0" Tapped="Tab_Tapped" Background="Transparent">
                    <Border x:Name="Sel0" CornerRadius="8,8,0,0" Background="{ThemeResource TabSelBrush}"
                            BorderBrush="{ThemeResource LineBrush}" BorderThickness="1,1,1,0" />
                    <StackPanel Padding="14,5,14,0">
                        <TextBlock x:Name="TabText0" Text="Data Entry" FontSize="13" Margin="0,0,0,5" />
                        <Rectangle x:Name="Under0" Height="2" RadiusX="1" RadiusY="1"
                                   Fill="{ThemeResource TabAccentBrush}" Margin="-2,0" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="TabHead1" Tag="1" Tapped="Tab_Tapped" Background="Transparent">
                    <Border x:Name="Sel1" CornerRadius="8,8,0,0" Background="{ThemeResource TabSelBrush}"
                            BorderBrush="{ThemeResource LineBrush}" BorderThickness="1,1,1,0" Visibility="Collapsed" />
                    <StackPanel Padding="14,5,14,0">
                        <TextBlock x:Name="TabText1" Text="Total Overview" FontSize="13" Margin="0,0,0,5" />
                        <Rectangle x:Name="Under1" Height="2" RadiusX="1" RadiusY="1"
                                   Fill="{ThemeResource TabAccentBrush}" Margin="-2,0" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="TabHead2" Tag="2" Tapped="Tab_Tapped" Background="Transparent">
                    <Border x:Name="Sel2" CornerRadius="8,8,0,0" Background="{ThemeResource TabSelBrush}"
                            BorderBrush="{ThemeResource LineBrush}" BorderThickness="1,1,1,0" Visibility="Collapsed" />
                    <StackPanel Padding="14,5,14,0">
                        <TextBlock x:Name="TabText2" Text="Breakdown" FontSize="13" Margin="0,0,0,5" />
                        <Rectangle x:Name="Under2" Height="2" RadiusX="1" RadiusY="1"
                                   Fill="{ThemeResource TabAccentBrush}" Margin="-2,0" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="TabHead3" Tag="3" Tapped="Tab_Tapped" Background="Transparent">
                    <Border x:Name="Sel3" CornerRadius="8,8,0,0" Background="{ThemeResource TabSelBrush}"
                            BorderBrush="{ThemeResource LineBrush}" BorderThickness="1,1,1,0" Visibility="Collapsed" />
                    <StackPanel Padding="14,5,14,0">
                        <TextBlock x:Name="TabText3" Text="By Species" FontSize="13" Margin="0,0,0,5" />
                        <Rectangle x:Name="Under3" Height="2" RadiusX="1" RadiusY="1"
                                   Fill="{ThemeResource TabAccentBrush}" Margin="-2,0" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Tab panel -->
            <Border Grid.Row="1" Background="{ThemeResource PanelBrush}" BorderBrush="{ThemeResource LineBrush}"
                    BorderThickness="1" CornerRadius="0,8,8,8" Padding="10,8,10,8">
                <Grid>
                    <Grid x:Name="TabPage1" RowSpacing="8" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource LineBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14,8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Book Total (Debtor + Cash)" Opacity="0.7" />
                                    <TextBlock x:Name="OvBookText" FontSize="18" FontWeight="SemiBold" Text="--" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource LineBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14,8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Grand Total (all suppliers)" Opacity="0.7" />
                                    <TextBlock x:Name="OvGrandText" FontSize="18" FontWeight="SemiBold" Text="--" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource LineBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14,8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Difference" Opacity="0.7" />
                                    <TextBlock x:Name="OvDiffText" FontSize="18" FontWeight="SemiBold" Text="--" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="6*" />
                        </Grid.ColumnDefinitions>
                        <ListView Grid.Column="0" x:Name="OvList" Background="{ThemeResource CardBrush}"
                                  BorderThickness="1" BorderBrush="{ThemeResource LineBrush}" CornerRadius="8" MinHeight="200">
                            <ListView.Header>
                                <Grid Background="{ThemeResource HeaderBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="16,5" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Supplier" HorizontalAlignment="Left" TextWrapping="Wrap" /></Border>
                                    <Border Grid.Column="1" Padding="16,5" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Kgs" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" /></Border>
                                    <Border Grid.Column="2" Padding="16,5" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Total ($)" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" /></Border>
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="32" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <!-- Books table (v5a): one row per book. Column widths must match kBookWidths[] in MainWindow.xaml.cpp. -->
                        <ListView Grid.Column="1" x:Name="BooksList" Background="{ThemeResource CardBrush}"
                                  BorderThickness="1" BorderBrush="{ThemeResource LineBrush}" CornerRadius="8" MinHeight="200">
                            <ListView.Header>
                                <Grid Background="{ThemeResource HeaderBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.3*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="1.5*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="10,5" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Book" HorizontalAlignment="Left" TextWrapping="Wrap" /></Border>
                                    <Border Grid.Column="1" Padding="10,5" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Rows" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" /></Border>
                                    <Border Grid.Column="2" Padding="10,5" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Kgs" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" /></Border>
                                    <Border Grid.Column="3" Padding="10,5" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Entered ($)" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" /></Border>
                                    <Border Grid.Column="4" Padding="10,5" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="From the book ($)" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" /></Border>
                                    <Border Grid.Column="5" Padding="10,5" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Difference ($)" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" /></Border>
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="32" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        </Grid>
                    </Grid>
                    <!-- Breakdown tab (6a): Supplier -> Species -> Price, built from the same core grouping as the Win32 app.
                         Column widths must match kBkWidths[] in MainWindow.xaml.cpp. Double-click a row for the entries behind it. -->
                    <Grid x:Name="TabPage2" RowSpacing="6" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Same three buttons as the Win32 Breakdown tab -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BkPreviewButton" Content="Print Preview..." Click="PrintPreview_Click" />
                            <Button x:Name="BkPrintButton" Content="Print / Save as PDF..." Click="Print_Click" />
                            <Button x:Name="BkEmailButton" Content="Email All Suppliers..." Click="EmailAll_Click" />
                            <TextBlock Text="Double-click a row to list the entries behind it." Opacity="0.7" FontSize="12"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <ListView Grid.Row="1" x:Name="BreakdownList" SelectionMode="Single" DoubleTapped="BreakdownList_DoubleTapped"
                                  Background="{ThemeResource CardBrush}" BorderThickness="1" BorderBrush="{ThemeResource LineBrush}"
                                  CornerRadius="8" MinHeight="200">
                            <ListView.Header>
                                <Grid Background="{ThemeResource HeaderBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="16,2" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Species" HorizontalAlignment="Left" TextWrapping="Wrap" /></Border>
                                    <Border Grid.Column="1" Padding="16,2" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Price ($/kg)" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" /></Border>
                                    <Border Grid.Column="2" Padding="16,2" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Kgs" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" /></Border>
                                    <Border Grid.Column="3" Padding="16,2" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Total ($)" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" /></Border>
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="24" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>
                    <!-- By Species tab (6b): per-species Kgs / Total / average, highest, lowest price (core ComputeSpeciesStats).
                         Column widths must match kSpWidths[] in MainWindow.xaml.cpp. -->
                    <ListView x:Name="TabPage3" SelectionMode="None" Visibility="Collapsed"
                              Background="{ThemeResource CardBrush}" BorderThickness="1" BorderBrush="{ThemeResource LineBrush}"
                              CornerRadius="8" MinHeight="200">
                        <ListView.Header>
                            <Grid Background="{ThemeResource HeaderBrush}">
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.5*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="16,2" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Species" HorizontalAlignment="Left" TextWrapping="Wrap" /></Border>
                                    <Border Grid.Column="1" Padding="16,2" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Kgs" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" /></Border>
                                    <Border Grid.Column="2" Padding="16,2" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Total ($)" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" /></Border>
                                    <Border Grid.Column="3" Padding="16,2" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Avg Price" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" /></Border>
                                    <Border Grid.Column="4" Padding="16,2" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Highest Price" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" /></Border>
                                    <Border Grid.Column="5" Padding="16,2" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Lowest Price" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" /></Border>
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="24" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <Grid x:Name="DataEntryPage" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Shown whenever a finalized (locked) day is open -->
                        <Border x:Name="FinalizedBar" Grid.Row="0" Visibility="Collapsed" CornerRadius="4"
                                Background="#FFF4CE" BorderBrush="#F0DC9A" BorderThickness="1" Padding="10,3,10,3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#9D5D00" VerticalAlignment="Center" />
                                <TextBlock x:Name="FinalizedTitle" FontSize="13" FontWeight="SemiBold" Foreground="#3B2F00" VerticalAlignment="Center" />
                                <TextBlock x:Name="FinalizedMsg" FontSize="13" Foreground="#3B2F00" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Row 1: Supplier, Species, Kgs, Price / kg, Add Entry -->
                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3.25*" />
                                <ColumnDefinition Width="3.23*" />
                                <ColumnDefinition Width="2.09*" />
                                <ColumnDefinition Width="2.18*" />
                                <ColumnDefinition Width="2.16*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="SupplierBox" PlaceholderText="Supplier" ToolTipService.ToolTip="Supplier" Grid.Column="0"
                                      IsEditable="True" HorizontalAlignment="Stretch" DropDownClosed="Combo_DropDownClosed" />
                            <ComboBox x:Name="SpeciesBox" PlaceholderText="Species" ToolTipService.ToolTip="Species" Grid.Column="1"
                                      IsEditable="True" HorizontalAlignment="Stretch" DropDownClosed="Combo_DropDownClosed" />
                            <TextBox x:Name="KgsBox" PlaceholderText="Kgs" ToolTipService.ToolTip="Kgs" Grid.Column="2" MaxLength="200" KeyDown="Price_KeyDown" />
                            <TextBox x:Name="PriceBox" PlaceholderText="Price / kg" ToolTipService.ToolTip="Price per kg" Grid.Column="3"
                                     KeyDown="Price_KeyDown" />
                            <Button x:Name="AddButton" Content="Add Entry" Grid.Column="4"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                    Style="{StaticResource AccentButtonStyle}" Click="Add_Click" />
                        </Grid>

                        <!-- Row 2: Date, Notes, Duplicate Entry, Repeat Supplier / Species -->
                        <Grid Grid.Row="2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.45*" />
                                <ColumnDefinition Width="4.3*" />
                                <ColumnDefinition Width="2.34*" />
                                <ColumnDefinition Width="1.83*" />
                                <ColumnDefinition Width="2.32*" />
                            </Grid.ColumnDefinitions>
                            <CalendarDatePicker x:Name="DateBox" PlaceholderText="Date" ToolTipService.ToolTip="Date" Grid.Column="0"
                                                HorizontalAlignment="Stretch"
                                                DateFormat="{}{day.integer(2)}/{month.integer(2)}/{year.full}" />
                            <TextBox x:Name="NotesBox" PlaceholderText="Notes" ToolTipService.ToolTip="Notes" MaxLength="4096" Grid.Column="1" KeyDown="Price_KeyDown" />
                            <TextBox x:Name="BookBox" ToolTipService.ToolTip="Book (new entries go in this book)" Grid.Column="2" IsReadOnly="True" Text="(no book)"
                                     FontWeight="SemiBold" />
                            <Button x:Name="DuplicateButton" Content="Duplicate Entry" Grid.Column="3"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Click="Duplicate_Click" />
                            <Button x:Name="RepeatButton" Content="Repeat Supplier / Species" Grid.Column="4"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Click="Repeat_Click" />
                        </Grid>

                        <!-- Row 3: toolbar + filter -->
                        <Grid Grid.Row="3" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DeleteButton" Grid.Column="0" Click="Delete_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="#D13438" />
                                    <TextBlock Text="Delete Selected" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="EditButton" Grid.Column="1" Click="Edit_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="{ThemeResource IconBlueBrush}" />
                                    <TextBlock Text="Edit Selected" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CancelEditButton" Grid.Column="2"
                                    IsEnabled="False" Click="CancelEdit_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                                    <TextBlock Text="Cancel Edit" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StartBookButton" Grid.Column="3" HorizontalAlignment="Left" Click="StartBook_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8F1;" FontSize="14" Foreground="{ThemeResource IconBlueBrush}" />
                                    <TextBlock Text="Start Book..." VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="4" Text="Filter" VerticalAlignment="Center" />
                            <TextBox x:Name="FilterBox" Grid.Column="5" PlaceholderText="Filter entries..."
                                     TextChanged="Filter_TextChanged" />
                        </Grid>

                        <!-- Entries table. Column widths must match kCols[] in MainWindow.xaml.cpp. -->
                        <ListView Grid.Row="4" x:Name="EntriesList" SelectionMode="Extended" SelectionChanged="EntriesList_SelectionChanged" DoubleTapped="EntriesList_DoubleTapped" RightTapped="EntriesList_RightTapped" Background="{ThemeResource CardBrush}"
                                  BorderThickness="1" BorderBrush="{ThemeResource LineBrush}" CornerRadius="8" MinHeight="200">
                            <ListView.Header>
                                <Grid Background="{ThemeResource HeaderBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.62*" />
                                        <ColumnDefinition Width="1.86*" />
                                        <ColumnDefinition Width="1.39*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.38*" />
                                        <ColumnDefinition Width="2.28*" />
                                        <ColumnDefinition Width="2.37*" />
                                        <ColumnDefinition Width="1.6*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="16,2" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Supplier" /></Border>
                                    <Border Grid.Column="1" Padding="16,2" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Species" /></Border>
                                    <Border Grid.Column="2" Padding="16,2" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Kgs" /></Border>
                                    <Border Grid.Column="3" Padding="16,2" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Price / kg" /></Border>
                                    <Border Grid.Column="4" Padding="16,2" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Total" /></Border>
                                    <Border Grid.Column="5" Padding="16,2" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Date" /></Border>
                                    <Border Grid.Column="6" Padding="16,2" BorderThickness="0,0,1,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Notes" /></Border>
                                    <Border Grid.Column="7" Padding="16,2" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource LineBrush}"><TextBlock Text="Book" /></Border>
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="24" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <!-- Reconciliation card -->
                        <Border Grid.Row="5" Background="{ThemeResource CardBrush}"
                                BorderBrush="{ThemeResource LineBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,8,14,8">
                            <Grid RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" MinWidth="110" />
                                    <ColumnDefinition Width="Auto" MinWidth="80" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" MinWidth="110" />
                                    <ColumnDefinition Width="Auto" MinWidth="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Reconciliation"
                                           FontWeight="SemiBold" FontSize="14" />
                                <TextBlock x:Name="ReasonText" Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="7"
                                           Text="" Foreground="Crimson" TextWrapping="Wrap" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Debtor amount(s)" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <TextBox x:Name="DebtorBox" Grid.Row="1" Grid.Column="1" MaxLength="4096"
                                         PlaceholderText="e.g. 1000+250-40" TextChanged="Box_TextChanged" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Cash amount(s)" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <TextBox x:Name="CashBox" Grid.Row="2" Grid.Column="1" MaxLength="4096"
                                         PlaceholderText="e.g. 530.50+120" TextChanged="Box_TextChanged" />

                                <Rectangle Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Width="1" Margin="22,0"
                                           Fill="{ThemeResource LineBrush}" VerticalAlignment="Stretch" />

                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Book total" VerticalAlignment="Center" />
                                <TextBlock x:Name="BookText" Grid.Row="1" Grid.Column="4" Text="$0.00"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="Entered total" VerticalAlignment="Center" />
                                <TextBlock x:Name="EnteredText" Grid.Row="2" Grid.Column="4" Text="$0.00"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />

                                <Rectangle Grid.Row="1" Grid.RowSpan="2" Grid.Column="5" Width="1" Margin="22,0"
                                           Fill="{ThemeResource LineBrush}" VerticalAlignment="Stretch" />

                                <StackPanel Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="2" Orientation="Horizontal"
                                            Spacing="12" VerticalAlignment="Center">
                                    <Grid Width="26" Height="26">
                                        <Ellipse x:Name="BadgeCircle" Fill="{ThemeResource GoodBrush}" />
                                        <FontIcon x:Name="OkIcon" Glyph="&#xE73E;" FontSize="14" Foreground="White" />
                                        <FontIcon x:Name="BadIcon" Glyph="&#xE711;" FontSize="12" Foreground="White" Visibility="Collapsed" />
                                    </Grid>
                                    <TextBlock x:Name="BadgeText" Text="Balanced" FontWeight="SemiBold"
                                               Foreground="{ThemeResource GoodBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Grid.Column="6" Text="Difference" VerticalAlignment="Center" />
                                <TextBlock x:Name="DiffText" Grid.Row="2" Grid.Column="7" Text="$0.00"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />

                                <Button x:Name="FinalizeButton" Grid.Row="1" Grid.RowSpan="2" Grid.Column="9"
                                        Content="Finalize Day" VerticalAlignment="Center" MinHeight="36" MinWidth="140"
                                        Click="Finalize_Click" />

                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="2" Padding="16,2" ColumnSpacing="12"
              BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CountText" Grid.Column="0" Text="0 entries" FontSize="12" />
            <Rectangle Grid.Column="1" Width="1" Height="14" Fill="{ThemeResource LineBrush}" />
            <TextBlock x:Name="FileText" Grid.Column="2" Text="File: (unsaved)" FontSize="12" />
            <Rectangle Grid.Column="3" Width="1" Height="14" Fill="{ThemeResource LineBrush}" />
            <TextBlock x:Name="StatusMsg" Grid.Column="4" Text="Prototype - open or save a .fbd file from the File menu." FontSize="12" />
            <TextBlock x:Name="SelText" Grid.Column="5" Text="" FontSize="12" FontWeight="SemiBold" Margin="0,0,16,0" />
            <TextBlock x:Name="VersionText" Grid.Column="6" Text="WinUI" FontSize="12" Opacity="0.7" />
        </Grid>
    </Grid>
    </Grid>
</Window>
